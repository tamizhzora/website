{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamizhzora",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  // KV namespace used for everything: users, videos, ads, gifts, friends,
  // notifications, coin history, admin audit log, settings/branding, etc.
  // Create it with:
  //   npx wrangler kv namespace create VIDEOS
  //   npx wrangler kv namespace create VIDEOS --preview
  // then paste the returned ids below.
  "kv_namespaces": [
    {
      "binding": "VIDEOS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_YOUR_PREVIEW_KV_NAMESPACE_ID"
    }
  ],

  // Non-secret configuration. This is the base URL your Google Drive
  // signed-link proxy runs on — safe to keep in plain vars.
  "vars": {
    "DRIVE_PROXY_BASE": "https://your-drive-proxy.example.com"
  }

  // Secrets are NOT set here — never commit passwords/keys to this file.
  // After deploying once, set them with:
  //   npx wrangler secret put ADMIN_PASSWORD
  //   npx wrangler secret put LINK_SECRET
  // ADMIN_PASSWORD: the password admins type at /admin/login.
  // LINK_SECRET: HMAC signing key used for signed video links, session
  //              tokens, and password hashing — treat it like a master key.
}
